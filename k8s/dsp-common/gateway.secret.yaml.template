---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dsp-ingress
  namespace: traefik-test
  annotations:
    nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
    ${K8S_INGRESS_ANNOTATIONS}
spec:
  ingressClassName: public-iks-k8s-nginx
  tls:
    - hosts:
        - tls.${DEPLOYMENT_BASE_URL}
      secretName: ${DEPLOYMENT_BASE_URL}
  rules:
    - host: tls.${DEPLOYMENT_BASE_URL}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: traefik
                port:
                  number: 443


---
apiVersion: gateway.networking.k8s.io/v1
kind: ReferenceGrant
metadata:
  name: gateways-access-tls-secret
  #namespace: ${ENVIRONMENT}
  namespace: traefik-test
spec:
  from:
    - group: gateway.networking.k8s.io
      kind: Gateway
      namespace: provider-${ENVIRONMENT}
    - group: gateway.networking.k8s.io
      kind: Gateway
      namespace: consumer-${ENVIRONMENT}
  to:
    - group: ""
      kind: Secret
      #name: ${TLS_SECRET}
      name: ${DEPLOYMENT_BASE_URL}